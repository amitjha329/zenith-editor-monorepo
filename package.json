{
  "name": "zenith-editor-monorepo",
  "version": "1.4.0",
  "description": "Monorepo for Zenith Editor - A modern WYSIWYG editor",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"packages/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\" --fix",
    "test": "pnpm -r test",
    "test:coverage": "pnpm --filter zenith-editor test:coverage",
    "clean": "pnpm -r clean",
    "demo": "pnpm --filter zenith-editor-demo dev",
    "build:demo": "pnpm --filter zenith-editor-demo build",
    "build:package": "pnpm --filter zenith-editor build",
    "type-check": "pnpm --filter zenith-editor tsc --noEmit",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prerelease": "pnpm lint && pnpm type-check && pnpm test && pnpm build:package",
    "publish:package": "pnpm --filter zenith-editor publish"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@8.15.1",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
